# 地府阴差管理系统 · 环境变量模板
#
# 用法（按需，不是必须）：
#   mkdir -p .run && cp .env.example .run/secrets.env
#   chmod 600 .run/secrets.env
#   然后解开需要的那几行注释、填上真值，再 ./start.sh
#
# 🔴 本文件只放空值和默认值，可以安全进 git。
#    .run/secrets.env 已被 .gitignore 拦住，真实 API Key / 口令**绝不能提交**。
#
# 加载规则见 config.py 的 _load_local_secrets()：
#   - 只补空缺，显式 export 的环境变量优先（方便临时换 Key / CI 注入）；
#   - 也可以完全不建这个文件，直接 export 同名变量，效果一样；
#   - 不配任何 Key 也能跑：大模型走规则兜底，流程引擎走内置状态机。
#
# ⚠️ 两层变量别混（很关键）：
#   - 本文件由 config.py 在 **Python 进程启动后**读取，只影响 Python 侧配置；
#   - HOST / PORT / PYTHON / DIFU_RUN_DIR 由 start.sh 在**更早的 shell 阶段**解析，
#     写进 secrets.env 不生效，必须直接写在命令行上：
#     例（命令行）：HOST=127.0.0.1 PORT=8900 PYTHON=./.venv/bin/python ./start.sh
#     例（命令行）：DIFU_RUN_DIR=/tmp/difu_test ./start.sh    # 隔离运行目录，测试用
#     尤其 DIFU_RUN_DIR：config.py 先靠它算出去哪找 secrets.env，
#     所以「在 secrets.env 里改 DIFU_RUN_DIR」逻辑上就不可能生效。
#
# 下面所有行都故意注释掉，复制过去默认什么都不改，装好即可启动。

# ------- 运行方式 -------
# DIFU_HOST=127.0.0.1            # 默认只监听本机；改 0.0.0.0 会对外开放，需先确认防火墙
# DIFU_PORT=8899                 # 与 start.sh / stop.sh / README 统一
# DIFU_FLOW_ENGINE=auto          # auto（装了 langgraph 就用）| langgraph | builtin
# DIFU_DEMO_MODE=0               # 1 = 课堂演示固定弱口令，仅限本机，勿上公网
# CORS_ALLOWED_ORIGINS=          # 逗号分隔白名单；同源部署留空即可
# MAX_UPLOAD_BYTES=10485760      # 单请求上传上限，默认 10MB
# APP_SECRET=                    # 留空则首次启动随机生成并写入 .run/app_secret（600）

# ------- 数据库 -------
# DB_ENGINE=sqlite               # sqlite | mysql（缺依赖时自动回落 sqlite）
# SQLITE_PATH=                   # 留空用 FastAPI/data/difu.db
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DB=difu

# ------- 大模型 / 多模态（不填就走规则兜底，功能不挂）-------
# LLM_API_KEY=                   # 兼容 OpenAI 协议：DeepSeek / 通义 / OpenAI ...
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_TIMEOUT=60
# VISION_API_KEY=
# VISION_BASE_URL=
# VISION_MODEL=qwen-vl-max
# ASR_API_KEY=
# ASR_BASE_URL=

# ------- 向量检索 -------
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=text-embedding-3-small
# VECTOR_STORE=local             # local | pgvector（缺依赖时自动回落 local）
# PGVECTOR_DSN=

# ------- 调度与安全 -------
# SCHEDULER_ENABLED=1            # 60s 巡检服刑期满的卷宗并自动续跑
# SCHEDULER_INTERVAL=60
# LOG_VERBOSE=0                  # 1 = 打印每条 HTTP 访问日志
# TOKEN_TTL=86400
# CHECKPOINT_TTL=86400
